# -----------------------------------------------
# MASXAI Subnet — LLM-key contribution pipeline
# Copy to .env and fill in your values.
# -----------------------------------------------

# -----------------------------------------------
# Bittensor wallet / network
# -----------------------------------------------
NETUID=501
SUBTENSOR_NETWORK=test
WALLET_NAME=default
WALLET_HOTKEY=default

# Where validator state (participation scores, llm-key hotkey status,
# self.scores) is persisted. Defaults to validator_state.json at repo root.
MASXAI_VALIDATOR_STATE_FILE=

# -----------------------------------------------
# Miner side: opt in to contribute up to 5 LLM keys to the protocol's pool
# -----------------------------------------------
MASXAI_LLM_KEY_CONTRIB_ENABLED=false
# Up to 5 keys as a JSON array; list order is the slot order (editing entry
# N replaces slot N's key on the next ask). Several keys for the SAME
# provider/model are allowed (capacity stacking); the same physical key
# twice is rejected by the protocol.
# MASXAI_LLM_KEYS_JSON=[{"provider":"openai","model":"gpt-4o","api_key":"sk-..."},{"provider":"openai","model":"gpt-4o","api_key":"sk-..."}]
# Legacy single-key config, still honored as slot 0 when the JSON var is
# unset:
MASXAI_LLM_KEY_CONTRIB_PROVIDER=
MASXAI_LLM_KEY_CONTRIB_MODEL=
MASXAI_LLM_KEY_CONTRIB_API_KEY=

# -----------------------------------------------
# Validator side: unset MASXAI_LLM_KEY_VALIDATOR_TOKEN to keep this pipeline
# off (open_llm_key_client_from_env() returns None; the validator then
# submits participation-only weights every epoch instead).
# -----------------------------------------------
MASXAI_LLM_KEY_BASE_URL=
MASXAI_LLM_KEY_VALIDATOR_TOKEN=
# MASXAI_LLM_KEY_SUBMISSION_INTERVAL_SECONDS=14400
# MASXAI_LLM_KEY_REPORT_POLL_INTERVAL_SECONDS=600
# MASXAI_LLM_KEY_EMA_ALPHA=0.15
# MASXAI_PARTICIPATION_EMA_ALPHA=0.2
# Force-score a low-traffic hotkey's rolling call accumulator after this
# long even if it hasn't crossed MASXAI_LLM_KEY_MIN_CALLS_FOR_SCORING yet.
# MASXAI_LLM_KEY_PENDING_WINDOW_MAX_SECONDS=604800
# Actively decay a hotkey's score toward zero once it's gone this long with
# no fresh usage report (rejected resubmission, DEAD, REVOKED) instead of
# leaving it frozen at its last value.
# MASXAI_LLM_KEY_STALENESS_TIMEOUT_SECONDS=172800
# Hard floors: a scored window whose success rate (strictly) or measured
# quality falls below these earns 0.0 -- and, when the window carries at
# least MASXAI_LLM_KEY_MIN_CALLS_FOR_SCORING calls, drops the miner's score
# straight to zero instead of riding the EMA down. The quality floor only
# acts once MASXAI_LLM_KEY_QUALITY_FLOOR_MIN_GRADED calls in the window
# actually carried a quality grade.
# MASXAI_LLM_KEY_RELIABILITY_HARD_FLOOR=0.5
# MASXAI_LLM_KEY_QUALITY_HARD_FLOOR=0.35
# MASXAI_LLM_KEY_QUALITY_FLOOR_MIN_GRADED=3
