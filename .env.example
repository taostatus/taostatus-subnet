GEMINI_API_KEY=
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=8
DISCORD_WEBHOOK_URL=
MASXAI_FALLBACK_TAO_PRICE_USD=
MASXAI_FORECAST_INTERVAL_SECONDS=300

# Miner Forecast Ingestion API (optional, validator-only). Reports miner
# registry state and forecast activity to a separate MASXAI backend,
# authenticated via a static X-API-Key. Fully opt-in: leave both unset to
# disable the integration entirely (no requests are ever made).
MASXAI_INGEST_BASE_URL=
INGEST_API_KEY=
MASXAI_INGEST_TIMEOUT=10
MASXAI_INGEST_MAX_RETRIES=3
MASXAI_INGEST_MINER_SYNC_INTERVAL_SECONDS=600
MASXAI_INGEST_QUEUE_MAX=1000
