TASK_SOURCE=bt_forecast

# Centralized BT-Forecast FastAPI service used by neurons/validator.py.
# Production base URL defaults to:
#   https://masx-bt-forecast-api-production.up.railway.app
# Validators fetch miner-safe questions from:
#   GET /v1/forecast-runs/{run_id}
#   GET /v1/forecast-runs/{run_id}/questions
#   GET /v1/resolutions?run_id={run_id}
# and post accurate resolved miner forecasts to:
#   POST /v1/miner-results
# Protected routes authorize with:
#   Authorization: Bearer $BT_FORECAST_BEARER_TOKEN
BT_FORECAST_BEARER_TOKEN=
MASXAI_BT_FORECAST_NO_ANSWER_RETRY_SECONDS=300
MASXAI_BT_FORECAST_NO_ANSWER_RETRY_MAX_SECONDS=3600
MASXAI_BT_FORECAST_NO_ANSWER_RETRY_BACKOFF_MULTIPLIER=1.5
MASXAI_BT_FORECAST_RESOLUTION_WAIT_SECONDS=432000
MASXAI_BT_FORECAST_RESOLUTION_RETRY_SECONDS=900
MASXAI_BT_FORECAST_RUN_STATE_RETENTION_SECONDS=1209600
MASXAI_BT_FORECAST_FEEDBACK_QUEUE_MAX=1000
# Ceiling on the server-supplied poll_after_s (seconds) and escalating alert
# thresholds for a run stuck at generation != "complete". Fallback is opt-in:
# 0 disables falling back to the legacy local-oracle issue path while stuck.
MASXAI_BT_FORECAST_POLL_AFTER_MAX_SECONDS=900
MASXAI_BT_FORECAST_STUCK_RUN_WARN_SECONDS=7200
MASXAI_BT_FORECAST_STUCK_RUN_ERROR_SECONDS=21600
MASXAI_BT_FORECAST_STUCK_RUN_FALLBACK_SECONDS=0
MASXAI_VALIDATOR_STATE_FILE=
MASXAI_MIN_RESOLVED_BEFORE_WEIGHTS=3

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
LLM_TASKS_PER_BATCH=20
LLM_TASK_CATEGORY_MIX=bittensor,subnets,tao,validators,miners,governance

DB_PATH=./data/subnet.db

VALIDATOR_UID=
VALIDATOR_HOTKEY=
NETUID=1
SUBTENSOR_NETWORK=finney
WALLET_NAME=default
WALLET_HOTKEY=default
DRY_RUN_WEIGHTS=true

SIMULATE_MINERS=true
MINER_REGISTRY_PATH=./miners.json
MINER_QUERY_TIMEOUT_SECONDS=12
MINER_MAX_CONCURRENT_QUERIES=50
MINER_QUERY_INTERVAL_SECONDS=15

PERIOD_CHECK_INTERVAL_SECONDS=15
RESOLUTION_INTERVAL_SECONDS=30
WEIGHT_SET_INTERVAL_SECONDS=300
MANUAL_RESOLUTION_PATH=./data/manual_resolutions.json

EMA_ALPHA=0.2
CALIBRATION_ERROR_THRESHOLD=0.2
CALIBRATION_PENALTY_FACTOR=0.5
WEIGHT_SKILL=0.55
WEIGHT_RECENT_SKILL=0.25
WEIGHT_VALID_RATE=0.10
WEIGHT_PARTICIPATION=0.10


GEMINI_ENABLED=true
# Must stay comfortably below the validator's QUERY_TIMEOUT (20s, masxai/constants.py)
# so a slow-but-successful Gemini call still has time to reach the validator -
# see GEMINI_TIMEOUT_MARGIN_SECONDS. Do not raise this close to/above 20.
GEMINI_TIMEOUT=8
DISCORD_WEBHOOK_URL=
MASXAI_FALLBACK_TAO_PRICE_USD=
MASXAI_FORECAST_INTERVAL_SECONDS=300

# Reject forecast queries from hotkeys without a validator permit. Recommended
# for any miner exposed beyond local testing; equivalent to (and, unlike,
# actually enforced by) --blacklist.force_validator_permit.
MASXAI_REQUIRE_VALIDATOR_PERMIT=true
