# -----------------------------------------------
# MASXAI Subnet — LLM-key contribution pipeline
# Copy to .env and fill in your values.
# -----------------------------------------------

# -----------------------------------------------
# Bittensor wallet / network
# -----------------------------------------------
NETUID=501
SUBTENSOR_NETWORK=test
WALLET_NAME=default
WALLET_HOTKEY=default

# Where validator state (participation scores, llm-key hotkey status,
# self.scores) is persisted. Defaults to validator_state.json at repo root.
MASXAI_VALIDATOR_STATE_FILE=

# -----------------------------------------------
# Miner side: opt in to contribute at least LLM_KEY_MIN_KEYS_PER_HOTKEY (5)
# distinct LLM keys to the protocol's pool (capped at
# LLM_KEY_MAX_KEYS_PER_HOTKEY, also 5 -- so exactly 5 today).
# -----------------------------------------------
MASXAI_LLM_KEY_CONTRIB_ENABLED=false
# Exactly 5 keys as a JSON array; list order is the slot order (editing
# entry N replaces slot N's key on the next ask). Several keys for the SAME
# provider/model are allowed (capacity stacking); the same physical key
# twice is deduped miner-side and rejected by the protocol. Fewer than 5
# distinct keys and the miner declines the round entirely rather than
# submitting a partial batch.
# MASXAI_LLM_KEYS_JSON=[{"provider":"openai","model":"gpt-4o-mini","api_key":"sk-..."},{"provider":"openai","model":"gpt-4o","api_key":"sk-..."},{"provider":"anthropic","model":"claude-3-5-haiku-20241022","api_key":"sk-ant-..."},{"provider":"anthropic","model":"claude-3-5-sonnet-20241022","api_key":"sk-ant-..."},{"provider":"deepseek","model":"deepseek-chat","api_key":"sk-..."}]
# Legacy single-key config, still honored as slot 0 when the JSON var is
# unset -- note it can never alone satisfy the minimum of 5:
MASXAI_LLM_KEY_CONTRIB_PROVIDER=
MASXAI_LLM_KEY_CONTRIB_MODEL=
MASXAI_LLM_KEY_CONTRIB_API_KEY=

# -----------------------------------------------
# Validator side: unset MASXAI_LLM_KEY_VALIDATOR_TOKEN to keep this pipeline
# off (open_llm_key_client_from_env() returns None; the validator then
# submits participation-only weights every epoch instead).
# -----------------------------------------------
MASXAI_LLM_KEY_BASE_URL=
MASXAI_LLM_KEY_VALIDATOR_TOKEN=
# MASXAI_LLM_KEY_SUBMISSION_INTERVAL_SECONDS=14400
# MASXAI_LLM_KEY_REPORT_POLL_INTERVAL_SECONDS=600
# MASXAI_PARTICIPATION_EMA_ALPHA=0.2
# Hard floors: a miner's epoch window whose success rate (strictly) or
# measured quality falls below these earns 0.0 for the epoch. The quality
# floor only acts once MASXAI_LLM_KEY_QUALITY_FLOOR_MIN_GRADED calls in the
# window actually carried a quality grade. A single key is killed on its own
# sub-window only once it carries MASXAI_LLM_KEY_MIN_CALLS_FOR_SCORING calls.
# MASXAI_LLM_KEY_MIN_CALLS_FOR_SCORING=5
# MASXAI_LLM_KEY_RELIABILITY_HARD_FLOOR=0.5
# MASXAI_LLM_KEY_QUALITY_HARD_FLOOR=0.35
# MASXAI_LLM_KEY_QUALITY_FLOOR_MIN_GRADED=3
